{
  "name": "XTML",
  "scopeName": "source.xtml",
  "fileTypes": ["xtml"],
  "patterns": [
    { "include": "#placeholders" },
    { "include": "#xtmlBlock" }, 
    { "include": "text.html.basic" } 
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.xtml",
          "match": "//.*$"
        },
        {
          "name": "comment.block.xtml",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.xtml",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.xtml",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "placeholders": {
      "patterns": [
        {
          "name": "meta.placeholder.xtml",
          "match": "\\{\\{\\s*(\\@)\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*\\}\\}",
          "captures": {
            "0": { "name": "punctuation.section.placeholder.braces.xtml" },
            "1": { "name": "constant.numeric" },
            "2": { "name": "variable.other.placeholder.xtml" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.xtml",
          "match": "\\b(var|return|import|for|if|else|while|continue|break|print|html)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.xtml",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.xtml",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.xtml",
          "match": "[+\\-*/=><&|%!]+"
        }
      ]
    },
    "varDeclarations": {
      "patterns": [
        {
          "name": "meta.declaration.var.xtml",
          "match": "\\b(var)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.xtml" },
            "2": { "name": "variable.other.definition.xtml" }
          }
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.xtml",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\b"
        }
      ]
    },
    "xtmlBlock": {
      "patterns": [
        {
          "name": "meta.embedded.xtml",
          "begin": "<xtml\\b[^>]*>",
          "beginCaptures": {
            "0": { "name": "meta.tag.xtml" }
          },
          "end": "</xtml>",
          "endCaptures": {
            "0": { "name": "meta.tag.xtml" }
          },
          "patterns": [
            { "include": "#comments" },
            { "include": "#strings" },
            { "include": "#varDeclarations" },
            { "include": "#keywords" },
            { "include": "#placeholders" },
            { "include": "#numbers" },
            { "include": "#identifiers" },
            { "include": "#operators" },
            { "include": "text.html.basic" }
          ]
        }
      ]
    }
  }
}